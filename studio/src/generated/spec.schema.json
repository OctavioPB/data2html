{
  "$defs": {
    "Dimension": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/FieldType"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "column",
        "type"
      ],
      "title": "Dimension",
      "type": "object"
    },
    "FieldType": {
      "enum": [
        "nominal",
        "ordinal",
        "temporal",
        "quantitative"
      ],
      "title": "FieldType",
      "type": "string"
    },
    "Filter": {
      "additionalProperties": false,
      "description": "Filter on a dimension. The value comes from a report parameter (`param`) or is fixed\n(`value`); exactly one of the two.",
      "properties": {
        "dimension": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Dimension",
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/FilterOp"
        },
        "param": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Report parameter that provides the value",
          "title": "Param"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fixed value; a list for 'in' and [from, to] for 'between'",
          "title": "Value"
        }
      },
      "required": [
        "dimension",
        "op"
      ],
      "title": "Filter",
      "type": "object"
    },
    "FilterOp": {
      "enum": [
        "eq",
        "neq",
        "in",
        "gte",
        "lte",
        "between"
      ],
      "title": "FilterOp",
      "type": "string"
    },
    "Layout": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        },
        "w": {
          "maximum": 12,
          "minimum": 1,
          "title": "W",
          "type": "integer"
        },
        "h": {
          "minimum": 1,
          "title": "H",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "Layout",
      "type": "object"
    },
    "Mark": {
      "enum": [
        "table",
        "kpi",
        "bar",
        "line",
        "pie"
      ],
      "title": "Mark",
      "type": "string"
    },
    "Measure": {
      "additionalProperties": false,
      "properties": {
        "sql": {
          "description": "One aggregate expression in DuckDB dialect over columns of the model's table, e.g. SUM(gross_amount - discount). No subqueries, windows or unknown functions; every column inside an aggregate.",
          "title": "Sql",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/MeasureFormat",
          "default": "number"
        },
        "owner": {
          "description": "Who is accountable for the definition",
          "title": "Owner",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "sql",
        "owner",
        "description"
      ],
      "title": "Measure",
      "type": "object"
    },
    "MeasureFormat": {
      "enum": [
        "number",
        "currency",
        "percent"
      ],
      "title": "MeasureFormat",
      "type": "string"
    },
    "Mode": {
      "enum": [
        "live",
        "snapshot"
      ],
      "title": "Mode",
      "type": "string"
    },
    "Param": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/ParamType"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Initial value in the viewer",
          "title": "Default"
        },
        "label": {
          "default": "",
          "description": "Text for the viewer's control; the name if empty",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "Param",
      "type": "object"
    },
    "ParamType": {
      "enum": [
        "int",
        "float",
        "str",
        "date",
        "bool"
      ],
      "title": "ParamType",
      "type": "string"
    },
    "Report": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "semantic_model": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Semantic Model",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/Mode",
          "default": "live",
          "description": "live: every view queries the source. snapshot: each reader's data (with their RLS) is computed once and kept until the report is republished or `refresh_hours` pass"
        },
        "refresh_hours": {
          "anyOf": [
            {
              "maximum": 2160,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "snapshot only: hours after which a reader's snapshot is recomputed; empty = until the report is republished",
          "title": "Refresh Hours"
        },
        "params": {
          "description": "parameter → type, or {type, default, label}",
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,62}$": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ParamType"
                },
                {
                  "$ref": "#/$defs/Param"
                }
              ]
            }
          },
          "title": "Params",
          "type": "object"
        },
        "access": {
          "default": [],
          "description": "Groups allowed to open the report; empty = any authenticated reader",
          "items": {
            "type": "string"
          },
          "title": "Access",
          "type": "array"
        },
        "visuals": {
          "items": {
            "$ref": "#/$defs/Visual"
          },
          "title": "Visuals",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "semantic_model",
        "visuals"
      ],
      "title": "Report",
      "type": "object"
    },
    "RlsRule": {
      "additionalProperties": false,
      "description": "Row filter for sources without native RLS: column = value of the reader's claim.",
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "claim": {
          "description": "Identity attribute, e.g. 'groups' or 'email'",
          "title": "Claim",
          "type": "string"
        }
      },
      "required": [
        "column",
        "claim"
      ],
      "title": "RlsRule",
      "type": "object"
    },
    "SemanticModel": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Name",
          "type": "string"
        },
        "source": {
          "description": "Id of a registered connection (never credentials)",
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Source",
          "type": "string"
        },
        "table": {
          "title": "Table",
          "type": "string"
        },
        "dimensions": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,62}$": {
              "$ref": "#/$defs/Dimension"
            }
          },
          "title": "Dimensions",
          "type": "object"
        },
        "measures": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,62}$": {
              "$ref": "#/$defs/Measure"
            }
          },
          "title": "Measures",
          "type": "object"
        },
        "rls": {
          "anyOf": [
            {
              "$ref": "#/$defs/RlsRule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "source",
        "table",
        "dimensions",
        "measures"
      ],
      "title": "SemanticModel",
      "type": "object"
    },
    "TimeGrain": {
      "enum": [
        "day",
        "week",
        "month",
        "quarter",
        "year"
      ],
      "title": "TimeGrain",
      "type": "string"
    },
    "Visual": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "mark": {
          "$ref": "#/$defs/Mark"
        },
        "measure": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Measure",
          "type": "string"
        },
        "dimension": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimension"
        },
        "time_grain": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeGrain"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Groups a temporal dimension by period (date_trunc)"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "filters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Filter"
          },
          "title": "Filters",
          "type": "array"
        },
        "layout": {
          "$ref": "#/$defs/Layout"
        }
      },
      "required": [
        "id",
        "title",
        "mark",
        "measure",
        "layout"
      ],
      "title": "Visual",
      "type": "object"
    }
  },
  "title": "data2html report-spec"
}

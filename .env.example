# Copia a .env. Nunca subas .env al repo.
D2H_AUTH_PROVIDERS=local            # local,oidc
D2H_SESSION_SECRET=cambia-esto
D2H_DATA_DIR=./data                 # Parquet de CSV subidos y bases DuckDB

# Postgres de desarrollo (docker compose)
PG_DEV_PASSWORD=d2h

# OIDC (SSO corporativo) — Fase 7
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Teradata — Fase 7
TD_HOST=
TD_USER=
TD_PASSWORD=

# IA — Fase 9 (deshabilitada por defecto)
D2H_AI_ENABLED=false
ANTHROPIC_API_KEY=
AWS_REGION=
